{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Worship Q",
  "version": "../package.json",
  "identifier": "com.worship-q.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Worship Q",
        "width": 760,
        "height": 760,
        "minWidth": 760,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/backgrounds/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCQ0Y0MUUxMDIyRTA5NTUKUldSVkNTNEM0VUhQVzdMaEVEMWdmRWp2Y1ZyS0Uydm5YT2dINVA0SXBNbHR4eVU4TnZoMzFEMDMK",
      "endpoints": ["https://github.com/iphren/worship-q/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
