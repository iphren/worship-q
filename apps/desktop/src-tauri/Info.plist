<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged into the bundle's Info.plist, and embedded in development builds. Without it,
       the webview hides navigator.mediaDevices (media uploads spike, M0.3). -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Worship Q lists your audio devices so you can choose where video sound plays.</string>
  <!-- The languages of the interface, with a folder each in Resources (locales/), so macOS
       shows its own windows, such as the file chooser, in the person's language. -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>zh-Hans</string>
    <string>zh-Hant</string>
  </array>
</dict>
</plist>
