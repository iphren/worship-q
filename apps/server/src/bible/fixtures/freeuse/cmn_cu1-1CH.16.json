{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","license":{"attribution":"not-required","commercialUse":"allowed","derivatives":"allowed","copyleft":false,"publicDomain":true},"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"7f3935061df17430a3e12f649490c443356f4f9d0aec5a2fabe421079a31aa13","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","completeTranslationApiLink":"/api/cmn_cu1/complete.json","simpleCompleteTranslationApiLink":"/api/cmn_cu1/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"1CH","translationId":"cmn_cu1","name":"历代志上","commonName":"历代志上","title":"历代志上","order":13,"numberOfChapters":29,"sha256":"2dff5904ea3a4b758c03fc84fc0d1a7c82384cdd76f8cc59f1e077897d8ff937","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/1CH/1.json","firstChapterReference":{"translationId":"cmn_cu1","book":"1CH","chapter":1},"lastChapterNumber":29,"lastChapterApiLink":"/api/cmn_cu1/1CH/29.json","lastChapterReference":{"translationId":"cmn_cu1","book":"1CH","chapter":29},"totalNumberOfVerses":939},"chapter":{"number":16,"content":[{"type":"line_break","paragraph":"p"},{"type":"verse","number":1,"content":["众人将 神的约柜请进去，安放在大卫所搭的帐幕里，就在 神面前献燔祭和平安祭。"]},{"type":"verse","number":2,"content":["大卫献完了燔祭和平安祭，就奉耶和华的名给民祝福，"]},{"type":"verse","number":3,"content":["并且分给以色列人，无论男女，每人一个饼，一块肉，一个葡萄饼。"]},{"type":"line_break","paragraph":"p"},{"type":"verse","number":4,"content":["大卫派几个利未人在耶和华的约柜前事奉，颂扬，称谢，赞美耶和华—以色列的 神："]},{"type":"verse","number":5,"content":["为首的是亚萨，其次是撒迦利雅、雅薛、示米拉末、耶歇、玛他提雅、以利押、比拿雅、俄别·以东、耶利，鼓瑟弹琴；惟有亚萨敲钹，大发响声；"]},{"type":"verse","number":6,"content":["祭司比拿雅和雅哈悉常在 神的约柜前吹号。"]},{"type":"verse","number":7,"content":["那日，大卫初次借亚萨和他的弟兄以诗歌称颂耶和华，说："]},{"type":"heading","content":["颂赞之歌"]},{"type":"verse","number":8,"content":[{"text":"你们要称谢耶和华，求告他的名，","poem":1},{"lineBreak":true},{"text":"在万民中传扬他的作为！","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"要向他唱诗、歌颂，","poem":1},{"lineBreak":true},{"text":"谈论他一切奇妙的作为。","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"要以他的圣名夸耀；","poem":1},{"lineBreak":true},{"text":"寻求耶和华的人，心中应当欢喜。","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"要寻求耶和华与他的能力，","poem":1},{"lineBreak":true},{"text":"时常寻求他的面。","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"他仆人以色列的后裔，","poem":1},{"lineBreak":true},{"text":"他所拣选雅各的子孙哪，","poem":1},{"lineBreak":true},{"text":"你们要记念他奇妙的作为和他的奇事，","poem":1},{"lineBreak":true},{"text":"并他口中的判语。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"他是耶和华—我们的 神，","poem":1},{"lineBreak":true},{"text":"全地都有他的判断。","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"你们要记念他的约，直到永远；","poem":1},{"lineBreak":true},{"text":"他所吩咐的话，直到千代，","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"就是与亚伯拉罕所立的约，","poem":1},{"lineBreak":true},{"text":"向以撒所起的誓。","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"他又将这约向雅各定为律例，","poem":1},{"lineBreak":true},{"text":"向以色列定为永远的约，","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"说：我必将迦南地赐给你，","poem":1},{"lineBreak":true},{"text":"作你产业的分。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"当时你们人丁有限，数目稀少，","poem":1},{"lineBreak":true},{"text":"并且在那地为寄居的；","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"他们从这邦游到那邦，","poem":1},{"lineBreak":true},{"text":"从这国行到那国。","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"耶和华不容什么人欺负他们，","poem":1},{"lineBreak":true},{"text":"为他们的缘故责备君王，","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"说：不可难为我受膏的人，","poem":1},{"lineBreak":true},{"text":"也不可恶待我的先知！","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"全地都要向耶和华歌唱！","poem":1},{"lineBreak":true},{"text":"天天传扬他的救恩，","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"在列邦中述说他的荣耀，","poem":1},{"lineBreak":true},{"text":"在万民中述说他的奇事。","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"因耶和华为大，当受极大的赞美；","poem":1},{"lineBreak":true},{"text":"他在万神之上，当受敬畏。","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"外邦的神都属虚无，","poem":1},{"lineBreak":true},{"text":"惟独耶和华创造诸天。","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"有尊荣和威严在他面前，","poem":1},{"lineBreak":true},{"text":"有能力和喜乐在他圣所。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"民中的万族啊，","poem":1},{"lineBreak":true},{"text":"你们要将荣耀能力归给耶和华，都归给耶和华！","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"要将耶和华的名所当得的荣耀归给他，","poem":1},{"lineBreak":true},{"text":"拿供物来奉到他面前；","poem":1},{"lineBreak":true},{"text":"当以圣洁的","poem":1},{"noteId":15},{"text":"妆饰敬拜耶和华。","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"全地要在他面前战抖，","poem":1},{"lineBreak":true},{"text":"世界也坚定不得动摇。","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"愿天欢喜，愿地快乐；","poem":1},{"lineBreak":true},{"text":"愿人在列邦中说：","poem":1},{"lineBreak":true},{"text":"耶和华作王了！","poem":1},{"lineBreak":true}]},{"type":"verse","number":32,"content":[{"text":"愿海和其中所充满的澎湃；","poem":1},{"lineBreak":true},{"text":"愿田和其中所有的都欢乐。","poem":1},{"lineBreak":true}]},{"type":"verse","number":33,"content":[{"text":"那时，林中的树木都要在耶和华面前欢呼，","poem":1},{"lineBreak":true},{"text":"因为他来要审判全地。","poem":1},{"lineBreak":true}]},{"type":"verse","number":34,"content":[{"text":"应当称谢耶和华；","poem":1},{"lineBreak":true},{"text":"因他本为善，他的慈爱永远长存！","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"要说：拯救我们的 神啊，求你救我们，","poem":1},{"lineBreak":true},{"text":"聚集我们，使我们脱离外邦，","poem":1},{"lineBreak":true},{"text":"我们好称赞你的圣名，以赞美你为夸胜。","poem":1},{"lineBreak":true}]},{"type":"verse","number":36,"content":[{"text":"耶和华—以色列的 神，","poem":1},{"lineBreak":true},{"text":"从亘古直到永远，是应当称颂的！","poem":1},{"lineBreak":true},{"text":"众民都说：「阿们！」并且赞美耶和华。","poem":1}]},{"type":"heading","content":["在耶路撒冷和基遍的敬拜"]},{"type":"line_break","paragraph":"p"},{"type":"verse","number":37,"content":["大卫派亚萨和他的弟兄在约柜前常常事奉耶和华，一日尽一日的职分；"]},{"type":"verse","number":38,"content":["又派俄别·以东和他的弟兄六十八人，与耶杜顿的儿子俄别·以东，并何萨作守门的；"]},{"type":"verse","number":39,"content":["且派祭司撒督和他弟兄众祭司在基遍的邱坛、耶和华的帐幕前燔祭坛上，每日早晚，照着耶和华律法书上所吩咐以色列人的，常给耶和华献燔祭。"]},{"type":"verse","number":41,"content":["与他们一同被派的有希幔、耶杜顿，和其余被选名字录在册上的，称谢耶和华，因他的慈爱永远长存。"]},{"type":"verse","number":42,"content":["希幔、耶杜顿同着他们吹号、敲钹，大发响声，并用别的乐器随着歌颂 神。耶杜顿的子孙作守门的。"]},{"type":"line_break","paragraph":"p"},{"type":"verse","number":43,"content":["于是众民各归各家；大卫也回去为家眷祝福。"]}],"footnotes":[{"noteId":15,"caller":"-","text":"的：或译为","reference":{"chapter":16,"verse":29}}]},"thisChapterLink":"/api/cmn_cu1/1CH/16.json","thisChapterReference":{"translationId":"cmn_cu1","book":"1CH","chapter":16},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/1CH/17.json","nextChapterReference":{"translationId":"cmn_cu1","book":"1CH","chapter":17},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/1CH/15.json","previousChapterReference":{"translationId":"cmn_cu1","book":"1CH","chapter":15},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":41,"simpleChapterApiLink":"/api/cmn_cu1/1CH/16.simple.json"}