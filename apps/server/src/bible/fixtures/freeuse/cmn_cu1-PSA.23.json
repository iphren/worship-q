{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","license":{"attribution":"not-required","commercialUse":"allowed","derivatives":"allowed","copyleft":false,"publicDomain":true},"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"7f3935061df17430a3e12f649490c443356f4f9d0aec5a2fabe421079a31aa13","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","completeTranslationApiLink":"/api/cmn_cu1/complete.json","simpleCompleteTranslationApiLink":"/api/cmn_cu1/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"31b895f5419553a44460b54a8db63a8835858765f68c8a5574b02ea6d08e3a76","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","firstChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","lastChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":150},"totalNumberOfVerses":2452},"chapter":{"number":23,"content":[{"type":"heading","content":["耶和华是我牧者"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华是我的牧者，","poem":1},{"lineBreak":true},{"text":"我必不致缺乏。","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"他使我躺卧在青草地上，","poem":1},{"lineBreak":true},{"text":"领我在可安歇的水边。","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"他使我的灵魂苏醒，","poem":1},{"lineBreak":true},{"text":"为自己的名引导我走义路。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我虽然行过死荫的幽谷，","poem":1},{"lineBreak":true},{"text":"也不怕遭害，","poem":1},{"lineBreak":true},{"text":"因为你与我同在；","poem":1},{"lineBreak":true},{"text":"你的杖，你的竿，都安慰我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"在我敌人面前，你为我摆设筵席；","poem":1},{"lineBreak":true},{"text":"你用油膏了我的头，使我的福杯满溢。","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"我一生一世必有恩惠慈爱随着我；","poem":1},{"lineBreak":true},{"text":"我且要住在耶和华的殿中，直到永远。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/23.json","thisChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":23},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/24.json","nextChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":24},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/22.json","previousChapterReference":{"translationId":"cmn_cu1","book":"PSA","chapter":22},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":6,"simpleChapterApiLink":"/api/cmn_cu1/PSA/23.simple.json"}