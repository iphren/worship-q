", "attrs": {"style": "q1"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.2", "verseOrgIds": ["PSA.23.2"]}, "items": [{"name": "verse", "type": "tag", "attrs": {"number": "2", "style": "v", "sid": "PSA 23:2"}, "items": [{"text": "2", "type": "text"}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.2", "verseOrgIds": ["PSA.23.2"]}, "items": [{"text": "He maketh me to lie down in green pastures: he leadeth me beside the still waters.", "type": "text", "attrs": {"verseId": "PSA.23.2", "verseOrgIds": ["PSA.23.2"]}}]}, {"name": "note", "type": "tag", "attrs": {"caller": "+", "style": "f", "id": "PSA.23.2!f.1", "verseId": "PSA.23.2"}, "items": [{"name": "char", "type": "tag", "attrs": {"style": "fr", "closed": "false"}, "items": [{"text": "23.2 ", "type": "text"}]}, {"name": "char", "type": "tag", "attrs": {"style": "ft", "closed": "false"}, "items": [{"text": "green…: Heb. pastures of tender grass", "type": "text"}]}]}, {"name": "note", "type": "tag", "attrs": {"caller": "+", "style": "f", "id": "PSA.23.2!f.2", "verseId": "PSA.23.2"}, "items": [{"name": "char", "type": "tag", "attrs": {"style": "fr", "closed": "false"}, "items": [{"text": "23.2 ", "type": "text"}]}, {"name": "char", "type": "tag", "attrs": {"style": "ft", "closed": "false"}, "items": [{"text": "still…: Heb. waters of quietness", "type": "text"}]}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.3", "verseOrgIds": ["PSA.23.3"]}, "items": [{"name": "verse", "type": "tag", "attrs": {"number": "3", "style": "v", "sid": "PSA 23:3"}, "items": [{"text": "3", "type": "text"}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.3", "verseOrgIds": ["PSA.23.3"]}, "items": [{"text": "He restoreth my soul: he leadeth me in the paths of righteousness for his name’s sake.", "type": "text", "attrs": {"verseId": "PSA.23.3", "verseOrgIds": ["PSA.23.3"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}, "items": [{"name": "verse", "type": "tag", "attrs": {"number": "4", "style": "v", "sid": "PSA 23:4"}, "items": [{"text": "4", "type": "text"}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}, "items": [{"text": "Yea, though I walk through the valley of the shadow of death, I will fear no evil: for thou ", "type": "text", "attrs": {"verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}}]}, {"name": "char", "type": "tag", "attrs": {"style": "add"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}, "items": [{"text": "art", "type": "text", "attrs": {"verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}, "items": [{"text": " with me; thy rod and thy staff they comfort me.", "type": "text", "attrs": {"verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.5", "verseOrgIds": ["PSA.23.5"]}, "items": [{"name": "verse", "type": "tag", "attrs": {"number": "5", "style": "v", "sid": "PSA 23:5"}, "items": [{"text": "5", "type": "text"}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.5", "verseOrgIds": ["PSA.23.5"]}, "items": [{"text": "Thou preparest a table before me in the presence of mine enemies: thou anointest my head with oil; my cup runneth over.", "type": "text", "attrs": {"verseId": "PSA.23.5", "verseOrgIds": ["PSA.23.5"]}}]}, {"name": "note", "type": "tag", "attrs": {"caller": "+", "style": "f", "id": "PSA.23.5!f.1", "verseId": "PSA.23.5"}, "items": [{"name": "char", "type": "tag", "attrs": {"style": "fr", "closed": "false"}, "items": [{"text": "23.5 ", "type": "text"}]}, {"name": "char", "type": "tag", "attrs": {"style": "ft", "closed": "false"}, "items": [{"text": "anointest: Heb. makest fat", "type": "text"}]}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.6", "verseOrgIds": ["PSA.23.6"]}, "items": [{"name": "verse", "type": "tag", "attrs": {"number": "6", "style": "v", "sid": "PSA 23:6"}, "items": [{"text": "6", "type": "text"}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.6", "verseOrgIds": ["PSA.23.6"]}, "items": [{"text": "Surely goodness and mercy shall follow me all the days of my life: and I will dwell in the house of the ", "type": "text", "attrs": {"verseId": "PSA.23.6", "verseOrgIds": ["PSA.23.6"]}}]}, {"name": "char", "type": "tag", "attrs": {"style": "nd"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.6", "verseOrgIds": ["PSA.23.6"]}, "items": [{"text": "LORD", "type": "text", "attrs": {"verseId": "PSA.23.6", "verseOrgIds": ["PSA.23.6"]}}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.6", "verseOrgIds": ["PSA.23.6"]}, "items": [{"text": " for ever.", "type": "text", "attrs": {"verseId": "PSA.23.6", "verseOrgIds": ["PSA.23.6"]}}]}, {"name": "note", "type": "tag", "attrs": {"caller": "+", "style": "f", "id": "PSA.23.6!f.1", "verseId": "PSA.23.6"}, "items": [{"name": "char", "type": "tag", "attrs": {"style": "fr", "closed": "false"}, "items": [{"text": "23.6 ", "type": "text"}]}, {"name": "char", "type": "tag", "attrs": {"style": "ft", "closed": "false"}, "items": [{"text": "for ever: Heb. to