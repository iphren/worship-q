{"data": {"id": "PSA.23.1-PSA.23.6", "orgId": "PSA.23.1-PSA.23.6", "bibleId": "7ea794434e9ea7ee-01", "bookId": "PSA", "chapterIds": ["PSA.23"], "reference": "诗篇 23:1-6", "content": [{"name": "para", "type": "tag", "attrs": {"style": "cl"}, "items": [{"text": "第23篇", "type": "text"}]}, {"name": "para", "type": "tag", "attrs": {"style": "s4"}, "items": [{"text": "耶和华是我的牧者", "type": "text"}]}, {"name": "para", "type": "tag", "attrs": {"style": "d"}, "items": [{"text": "大卫的诗。", "type": "text"}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.1", "verseOrgIds": ["PSA.23.1"]}, "items": [{"name": "verse", "type": "tag", "attrs": {"number": "1", "style": "v", "sid": "PSA 23:1"}, "items": [{"text": "1", "type": "text"}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.1", "verseOrgIds": ["PSA.23.1"]}, "items": [{"text": "耶和华是我的牧者，", "type": "text", "attrs": {"verseId": "PSA.23.1", "verseOrgIds": ["PSA.23.1"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1", "vid": "PSA 23:1"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.1", "verseOrgIds": ["PSA.23.1"]}, "items": [{"text": "我必一无所缺。", "type": "text", "attrs": {"verseId": "PSA.23.1", "verseOrgIds": ["PSA.23.1"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.2", "verseOrgIds": ["PSA.23.2"]}, "items": [{"name": "verse", "type": "tag", "attrs": {"number": "2", "style": "v", "sid": "PSA 23:2"}, "items": [{"text": "2", "type": "text"}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.2", "verseOrgIds": ["PSA.23.2"]}, "items": [{"text": "祂让我躺卧在青草地上，", "type": "text", "attrs": {"verseId": "PSA.23.2", "verseOrgIds": ["PSA.23.2"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1", "vid": "PSA 23:2"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.2", "verseOrgIds": ["PSA.23.2"]}, "items": [{"text": "领我到幽静的溪水旁。", "type": "text", "attrs": {"verseId": "PSA.23.2", "verseOrgIds": ["PSA.23.2"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.3", "verseOrgIds": ["PSA.23.3"]}, "items": [{"name": "verse", "type": "tag", "attrs": {"number": "3", "style": "v", "sid": "PSA 23:3"}, "items": [{"text": "3", "type": "text"}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.3", "verseOrgIds": ["PSA.23.3"]}, "items": [{"text": "祂使我的心灵苏醒，", "type": "text", "attrs": {"verseId": "PSA.23.3", "verseOrgIds": ["PSA.23.3"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1", "vid": "PSA 23:3"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.3", "verseOrgIds": ["PSA.23.3"]}, "items": [{"text": "为了自己的名引导我走正路。", "type": "text", "attrs": {"verseId": "PSA.23.3", "verseOrgIds": ["PSA.23.3"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}, "items": [{"name": "verse", "type": "tag", "attrs": {"number": "4", "style": "v", "sid": "PSA 23:4"}, "items": [{"text": "4", "type": "text"}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}, "items": [{"text": "我纵使走过死亡的幽谷，", "type": "text", "attrs": {"verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1", "vid": "PSA 23:4"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}, "items": [{"text": "也不怕遭害，", "type": "text", "attrs": {"verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1", "vid": "PSA 23:4"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}, "items": [{"text": "因为你与我同在，", "type": "text", "attrs": {"verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1", "vid": "PSA 23:4"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}, "items": [{"text": "你的杖和竿带给我安慰。", "type": "text", "attrs": {"verseId": "PSA.23.4", "verseOrgIds": ["PSA.23.4"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.5", "verseOrgIds": ["PSA.23.5"]}, "items": [{"name": "verse", "type": "tag", "attrs": {"number": "5", "style": "v", "sid": "PSA 23:5"}, "items": [{"text": "5", "type": "text"}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.5", "verseOrgIds": ["PSA.23.5"]}, "items": [{"text": "在我敌人面前你为我摆设宴席，", "type": "text", "attrs": {"verseId": "PSA.23.5", "verseOrgIds": ["PSA.23.5"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1", "vid": "PSA 23:5"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.5", "verseOrgIds": ["PSA.23.5"]}, "items": [{"text": "又用膏油浇我的头，", "type": "text", "attrs": {"verseId": "PSA.23.5", "verseOrgIds": ["PSA.23.5"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1", "vid": "PSA 23:5"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.5", "verseOrgIds": ["PSA.23.5"]}, "items": [{"text": "使我恩福满溢。", "type": "text", "attrs": {"verseId": "PSA.23.5", "verseOrgIds": ["PSA.23.5"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.6", "verseOrgIds": ["PSA.23.6"]}, "items": [{"name": "verse", "type": "tag", "attrs": {"number": "6", "style": "v", "sid": "PSA 23:6"}, "items": [{"text": "6", "type": "text"}]}]}, {"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.6", "verseOrgIds": ["PSA.23.6"]}, "items": [{"text": "你的恩惠和慈爱必追随我一生，", "type": "text", "attrs": {"verseId": "PSA.23.6", "verseOrgIds": ["PSA.23.6"]}}]}]}, {"name": "para", "type": "tag", "attrs": {"style": "q1", "vid": "PSA 23:6"}, "items": [{"name": "verse-span", "type": "tag", "attrs": {"class": "verse-span", "verseId": "PSA.23.6", "verseOrgIds": ["PSA.23.6"]}, "items": [{"text": "我要永远住在你的殿中。", "type": "text", "attrs": {"verseId": "PSA.23.6", "verseOrgIds": ["PSA.23.6"]}}]}]}], "verseCount": 6, "copyright": "Biblica® 圣经当代译本™开放资源 版权所有©1979, 2005, 2007, 2011, 2022 Biblica, Inc. Biblica® Open Chinese Contemporary Bible™ (Simplified Script) Copyright © 1979, 2005, 2007, 2011, 2022 by Biblica, Inc. “Biblica”是国际圣经协会在美国专利和商标局注册的商标。获得授权使用。 “Biblica” is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission."}, "meta": {}}