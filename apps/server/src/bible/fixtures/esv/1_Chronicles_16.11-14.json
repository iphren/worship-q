{"query": "1 Chronicles 16:11\u201314", "canonical": "1 Chronicles 16:11\u201314", "parsed": [[13016011, 13016014]], "passage_meta": [{"canonical": "1 Chronicles 16:11\u201314", "chapter_start": [13016001, 13016043], "chapter_end": [13016001, 13016043], "prev_verse": 13016010, "next_verse": 13016015, "prev_chapter": [13015001, 13015029], "next_chapter": [13017001, 13017027]}], "passages": ["<h2 class=\"extra_text\">1 Chronicles 16:11\u201314</h2>\n<p class=\"block-indent\"><span class=\"begin-line-group\"></span>\n<span id=\"p13016011_01-1\" class=\"line\"><b class=\"verse-num inline\" id=\"v13016011-1\">11&nbsp;</b>&nbsp;&nbsp;Seek the LORD and his strength;</span><br /><span id=\"p13016011_01-1\" class=\"indent line\">&nbsp;&nbsp;&nbsp;&nbsp;seek his presence continually!</span><br /><span id=\"p13016012_01-1\" class=\"line\"><b class=\"verse-num inline\" id=\"v13016012-1\">12&nbsp;</b>&nbsp;&nbsp;Remember the wondrous works that he has done,</span><br /><span id=\"p13016012_01-1\" class=\"indent line\">&nbsp;&nbsp;&nbsp;&nbsp;his miracles and the judgments he uttered,</span><br /><span id=\"p13016013_01-1\" class=\"line\"><b class=\"verse-num inline\" id=\"v13016013-1\">13&nbsp;</b>&nbsp;&nbsp;O offspring of Israel his servant,</span><br /><span id=\"p13016013_01-1\" class=\"indent line\">&nbsp;&nbsp;&nbsp;&nbsp;children of Jacob, his chosen ones!</span><br /><span class=\"end-line-group\"></span>\n<span class=\"begin-line-group\"></span>\n<span id=\"p13016014_01-1\" class=\"line\"><b class=\"verse-num inline\" id=\"v13016014-1\">14&nbsp;</b>&nbsp;&nbsp;He is the LORD our God;</span><br /><span id=\"p13016014_01-1\" class=\"indent line\">&nbsp;&nbsp;&nbsp;&nbsp;his judgments are in all the earth.</span><br /></p><span class=\"end-line-group\"></span>\n<p>(<a href=\"http://www.esv.org\" class=\"copyright\">ESV</a>)</p>"]}