{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "worship-q",
      "changelog-path": "apps/desktop/CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "exclude-paths": ["docs", "apps/server", "apps/remote", "apps/website"],
      "extra-files": [
        { "type": "json", "path": "apps/desktop/package.json", "jsonpath": "$.version" },
        {
          "type": "toml",
          "path": "apps/desktop/src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "apps/desktop/src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'worship-q')].version"
        }
      ]
    }
  }
}
